############################################################
# +------------------------------------------------------+ #
# |                    Join Messages                     | #
# +------------------------------------------------------+ #
############################################################

# Should network join messages be displayed?
showjoin: true

# Should network quit messages be displayed?
showleave: true

##############################################################

# USES STANDARD MINECRAFT '&X' COLOUR/FORMAT CODES
# %NAME% = The name of the sender

# NETWORK join message
serverjoin: "&e%NAME% &ehat das Spiel betreten"

# NETWORK SILENT join message
silentjoin: "&7%NAME% &7hat das Spiel leise betreten"

# NETWORK quit message
serverleave: "&e%NAME% &ehat das Spiel verlassen"

# NETWORK SILENT quit message
silentleave: "&7%NAME% &7hat das Spiel leise verlassen"

# PRIVATE join message
# Should a message be broadcast to the player when joining?
private_serverjoin: true
private_serverjoin_file: welcomeText-default.txt

##############################################################

# Should a welcome message be broadcast to the network the first time a player joins?
welcome: true

# Define the welcome message here
# USES STANDARD MINECRAFT '&X' COLOUR/FORMAT CODES
# %NAME% = The name of the sender
welcome_message: "&bHallo &e%NAME% &bherzlich willkommen auf &eCraftTogetherMC&b!"

# Should a private welcome message (separate to the one above) be sent to the player the first time they join the network?
private_welcome: false

# Define the private welcome message here
# USES STANDARD MINECRAFT '&X' COLOUR/FORMAT CODES
# %NAME% = The name of the sender
private_welcome_message: "&cWillkommen, &6%NAME%&c!"
